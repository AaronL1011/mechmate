# Mechmate Self-Hosted Configuration Example
# Copy this file to .env and modify the values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, production, test)
NODE_ENV=production

# Server configuration
PORT=3000
HOST=0.0.0.0

# Application metadata
MECHMATE_VERSION=0.0.1
INSTANCE_NAME="Mechmate Self-Hosted"

# Public base URL for QR codes and absolute links (optional). Use when the app is behind a reverse
# proxy so scanned equipment URLs match what clients resolve (e.g. https://maintenance.example.com).
# PUBLIC_APP_URL=https://maintenance.example.com

# =============================================================================
# DATABASE SETTINGS
# =============================================================================

# Directory where the SQLite database will be stored
# The application will create 'mechmate.db' in this directory
DATABASE_DIR=data

# Directory for database backups
DATABASE_BACKUP_DIR=data/backups
DATABASE_BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_HOURS=24
AUTO_BACKUP_MAX_FILES=7

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Rate limiting (recommended for public deployments)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# AI ASSISTANT (OPTIONAL)
# =============================================================================

# OpenAI-compatible API (OpenAI, OpenRouter, local LLMs, etc.)
# If not set, AI assistant will be disabled
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000
LLM_TIMEOUT_MS=30000

# --- OpenRouter (https://openrouter.ai) - good for tool use / agent workflows ---
# OPENAI_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-3.5-sonnet
# OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_TOKENS=4096

# --- Local OpenAI-compatible (e.g. Ollama) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# =============================================================================
# PUSH NOTIFICATIONS (OPTIONAL)
# =============================================================================

# VAPID keys for web push notifications
# Generate with: npx web-push generate-vapid-keys
# If not set, push notifications will be disabled
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com

# =============================================================================
# STORAGE SETTINGS
# =============================================================================

# File upload settings
UPLOAD_MAX_SIZE_MB=10
# Optional: larger limit for equipment resource documents (manuals); defaults to UPLOAD_MAX_SIZE_MB
# RESOURCE_UPLOAD_MAX_SIZE_MB=25
UPLOAD_DIR=data/uploads

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Health checks and metrics
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Dev server runs with HTTPS (via @vitejs/plugin-basic-ssl) so microphone works.
# Browsers require a secure context (HTTPS or localhost) for getUserMedia.
# Use https://localhost:5173 (or the URL shown by `npm run dev`).

# Enable debug features (only for development)
ENABLE_DEBUG_LOGS=false

# CORS settings (only enable if accessing from different domains)
CORS_ENABLED=false
# CORS_ORIGIN=http://localhost:5173